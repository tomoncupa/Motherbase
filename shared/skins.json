      "texture": {
        "display": "'Silkscreen',system-ui,-apple-system,sans-serif",
        "cut": "0px",
        "image": "repeating-linear-gradient(45deg,rgba(0,0,0,.035) 0 2px,transparent 2px 5px)",
        "size": "auto"
      },
      "font": "Silkscreen:wght@400;700",
      "css": "/* RAGNAROK — a 2002 MMO client.\n   Every surface is a plate with thickness: lit along the top and left, shaded\n   along the bottom and right. Nothing floats, nothing fades, and a button\n   physically goes IN when you press it.\n   No layout is touched. Only the drawing of each box changes. */\n\nbody { letter-spacing: var(--track-body) }\n\n/* ---- the title bar ---- */\nheader {\n  background: linear-gradient(180deg, rgba(255,255,255,.24), rgba(0,0,0,.22)), var(--accent);\n  color: var(--accent-fg);\n  border-bottom: 2px solid rgba(0,0,0,.5);\n  box-shadow: inset 1px 1px 0 rgba(255,255,255,.34);\n}\nheader .logo {\n  font-family: var(--font-display);\n  font-size: var(--f-2);\n  color: var(--accent-fg);\n  letter-spacing: var(--track-cap);\n  text-shadow: 1px 1px 0 rgba(0,0,0,.6);\n}\nheader .logo b { color: var(--accent-fg); opacity: .7 }\n\n/* ---- plates: anything that holds content ---- */\n.card, .mb-sheet, .mb-toast, .mb-menu {\n  background: var(--surface-1);\n  border: var(--border-width) solid var(--border);\n  box-shadow: var(--e-2);\n}\n\n/* A window gets a proper title strip, not a heading floating on the plate. */\n.mb-sheet-head {\n  background: linear-gradient(180deg, rgba(255,255,255,.24), rgba(0,0,0,.22)), var(--accent);\n  color: var(--accent-fg);\n  font-family: var(--font-display);\n  letter-spacing: var(--track-cap);\n  text-shadow: 1px 1px 0 rgba(0,0,0,.6);\n  box-shadow: inset 1px 1px 0 rgba(255,255,255,.34);\n}\n.mb-sheet-head .mb-grab { background: rgba(255,255,255,.5) }\n\n/* A section heading is a stamped label with a rule under it. */\nh2 {\n  font-family: var(--font-display);\n  color: var(--text-1);\n  border-bottom: var(--border-width) solid var(--border);\n  padding-bottom: var(--s-2);\n  text-shadow: 1px 1px 0 rgba(255,255,255,.6);\n}\n\n/* ---- wells: rows, inputs, tracks. Pressed into the plate. ---- */\n.item, .mb-input, .mb-sel, .mb-range, .mb-sw {\n  background: var(--surface-2);\n  border: var(--border-width) solid var(--border);\n  box-shadow: var(--bevel-in);\n}\n\n/* ---- buttons: raised, and they go in under the finger ---- */\nbutton.mb-btn, .mb-act, button.chk, #fab, .mb-chip, .mb-x, .mb-opt {\n  font-family: var(--font-display);\n  letter-spacing: var(--track-cap);\n  background: var(--surface-3);\n  color: var(--text-1);\n  border: var(--border-width) solid var(--border);\n  box-shadow: var(--e-1);\n  transition: none;\n}\nbutton.mb-btn:active, .mb-act:active, button.chk:active,\n#fab:active, .mb-chip:active, .mb-x:active, .mb-opt:active {\n  box-shadow: var(--bevel-in);\n  transform: translate(1px, 1px);\n}\n\n/* The one loud action keeps the accent, but as a plate rather than a pill. */\n#fab {\n  background: linear-gradient(180deg, rgba(255,255,255,.24), rgba(0,0,0,.2)), var(--accent);\n  color: var(--accent-fg);\n  border-radius: 0;\n  font-family: var(--font-display);\n  font-size: var(--f-5);\n  text-shadow: 1px 1px 0 rgba(0,0,0,.5);\n}\n\n/* A ticked box is a lit gem set into the plate, not a filled circle. */\nbutton.chk { border-radius: 0 }\nbutton.chk.on {\n  background: linear-gradient(180deg, rgba(255,255,255,.3), rgba(0,0,0,.2)), var(--accent);\n  color: var(--accent-fg);\n  box-shadow: var(--e-1);\n}\n\n/* Selection is a hard inverted bar, the way a list worked before hover did. */\n.mb-opt:hover, .mb-chip.on {\n  background: var(--accent);\n  color: var(--accent-fg);\n}"
    }
